			<template file="template3D.raw">
				<size>64,64,32</size>
			</template>
			<target file="target3D.raw">
				<size>64,64,32</size>
			</target>
			<range_min>0,0,0</range_min>
			<range_max>15,15,8</range_max>
            <window_size>1.2,1.2,1.25</window_size>
			<penalty lc="1">0.8</penalty>
			<blur lc="2">1</blur>
			<laugon>1</laugon>
			<altol>0.1</altol>
		</constraint>
	</Constraints>
